# Render Free: email via HTTPS API (not SMTP). DO NOT add real secrets to git.
HOST=127.0.0.1
PORT=8000
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# Add notify.aozaltechnologies.com as a verified SENDING domain in Resend first.
RESEND_FROM=AOZAL Website <notifications@notify.aozaltechnologies.com>
INFO_EMAIL=info@aozaltechnologies.com
SUPPORT_EMAIL=support@aozaltechnologies.com

# Leave 0 until you verify your reverse proxy's trusted forwarded-IP behavior.
TRUSTED_PROXY_HOPS=0

# Optional AWS migration alternative: EMAIL_PROVIDER=smtp + uncomment these.
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=info@aozaltechnologies.com
# SMTP_PASSWORD=YOUR_SECRET_SERVER_SIDE_ONLY
# SMTP_FROM=info@aozaltechnologies.com
